{
  "name": "microfrontend-react-lab",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n frontends,bff,mocks \"npm run dev:frontends\" \"npm run dev -w @lab/catalog-bff\" \"npm run dev -w @lab/mock-services\"",
    "build": "npm run build --workspaces --if-present && node scripts/copy-config.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "serve": "concurrently -k \"npm run serve:frontends\" \"npm start -w @lab/catalog-bff\" \"npm start -w @lab/mock-services\"",
    "dev:frontends": "concurrently -k -n shell,catalog,cart \"npm run dev -w @lab/shell\" \"npm run dev -w @lab/catalog\" \"npm run dev -w @lab/cart\"",
    "serve:frontends": "concurrently -k \"npm run serve -w @lab/shell\" \"npm run serve -w @lab/catalog\" \"npm run serve -w @lab/cart\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.0",
    "@playwright/test": "^1.56.0",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.2.0",
    "css-loader": "^7.1.0",
    "html-webpack-plugin": "^5.6.0",
    "http-server": "^14.1.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.0",
    "webpack-dev-server": "^6.1.0"
  }
}
